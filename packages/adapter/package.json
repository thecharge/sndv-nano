{
  "name": "@thecharge/sndv-adapter",
  "version": "0.1.0",
  "description": "SMEP LLM adapters: OpenAI-compatible client, opencode/Claude/Copilot integration.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "format": "biome check --write src/",
    "lint": "biome check src/",
    "check": "bun run lint && tsc --noEmit && bun test",
    "prepublishOnly": "bun run build"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thecharge/sndv-config": "workspace:*"
  }
}
